{
  "tasks": {
    "dev": "deno run --unstable-kv --allow-net --allow-env --allow-read=./static,./canon/static,./.env --watch main.js",
    "start": "deno run --unstable-kv --allow-net --allow-env --allow-read=./static,./canon/static,./.env main.js",
    "lint": "deno lint main.js canon/ util/"
  },
  "deploy": {
    "exclude": [
      "**/node_modules"
    ],
    "include": []
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@thednp/domparser": "npm:@thednp/domparser@^0.2.0",
    "feedsmith": "npm:feedsmith@^3.0.1"
  }
}
